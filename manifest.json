{
	"$schema": "https://raw.githubusercontent.com/atampy25/simple-mod-framework/main/Mod%20Manager/src/lib/manifest-schema.json",
	"version": "1.0.1",
	"id": "timbeater.limpier-ragdolls-mod",
	"name": "Limpier Ragdolls",
	"description": "Makes the ragdolls limpy.",
	"authors": ["timbeater"],
	"frameworkVersion": "2.33.42",
	"options": [
		{
			"name": "Ragdoll",
			"tooltip": "Reduces the stagger effect in the active ragdolls",
			"enabledByDefault": true,
			"type": "checkbox",
			"contentFolders": ["content/ragdoll"]
		},
		{
			"name": "Gravity",
			"tooltip": "Increases the gravity to make ragdolls fall faster",
			"enabledByDefault": false,
			"type": "checkbox",
			"contentFolders": ["content/gravity"]
		}
	],
	"updateCheck": "https://github.com/timb-eater/limpier-ragdoll-mod/releases/latest/download/updates.json"
}
