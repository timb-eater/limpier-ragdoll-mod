{
	"$schema": "https://raw.githubusercontent.com/atampy25/simple-mod-framework/main/Mod%20Manager/src/lib/manifest-schema.json",
	"version": "0.1.0",
	"id": "timbeater.no-active-ragdoll-mod",
	"name": "No Active Ragdoll Mod",
	"description": "A truly amazing mod",
	"authors": ["timbeater"],
	"frameworkVersion": "2.25.1",
	"options": [
		{
			"name": "Gravity",
			"tooltip": "Increases the gravity to make ragdolls fall faster",
			"enabledByDefault": true,
			"type": "checkbox",
			"contentFolders": ["gravity"]
		},
		{
			"name": "Ragdoll",
			"tooltip": "Reduces the stagger effect in the active ragdolls",
			"enabledByDefault": true,
			"type": "checkbox",
			"contentFolders": ["ragdoll"]
		}
	]
}
